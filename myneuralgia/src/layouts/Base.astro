---
interface Props {
  title: string;
  description?: string;
  canonical?: string;
  hreflangPl?: string;
  ogImage?: string;
}

const { title, description, canonical, hreflangPl, ogImage } = Astro.props;
const siteName = 'My Neuralgia';
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} | {siteName}</title>
  {description && <meta name="description" content={description} />}
  {canonical && <link rel="canonical" href={canonical} />}
  {hreflangPl && <link rel="alternate" hreflang="pl" href={hreflangPl} />}
  {canonical && <link rel="alternate" hreflang="en" href={canonical} />}
  {canonical && <link rel="alternate" hreflang="x-default" href={hreflangPl || canonical} />}
  {ogImage && <meta property="og:image" content={ogImage} />}
  <meta property="og:title" content={title} />
  {description && <meta property="og:description" content={description} />}
  <meta property="og:type" content="article" />
  <meta property="og:locale" content="en_US" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <style>
    :root {
      --color-primary: #2c5d55;
      --color-accent: #3a7a6f;
      --color-warm: #c9805a;
      --color-text: #1a1a1a;
      --color-muted: #6b7280;
      --color-bg: #fafafa;
      --color-card: #ffffff;
      --max-width: 720px;
    }
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif;
      color: var(--color-text);
      background: var(--color-bg);
      line-height: 1.7;
      font-size: 18px;
    }
    header {
      background: var(--color-primary);
      color: white;
      padding: 1rem 2rem;
    }
    header a { color: white; text-decoration: none; font-weight: 700; font-size: 1.2rem; }
    nav { display: flex; gap: 1.5rem; align-items: center; max-width: var(--max-width); margin: 0 auto; }
    main { max-width: var(--max-width); margin: 2rem auto; padding: 0 1.5rem; }
    footer {
      max-width: var(--max-width);
      margin: 3rem auto 2rem;
      padding: 2rem 1.5rem;
      border-top: 1px solid #e5e7eb;
      color: var(--color-muted);
      font-size: 0.85rem;
    }
    a { color: var(--color-accent); }
    h1 { font-size: 2rem; line-height: 1.3; margin-bottom: 1rem; color: var(--color-primary); }
    h2 { font-size: 1.4rem; margin: 2rem 0 0.75rem; color: var(--color-primary); }
    h3 { font-size: 1.15rem; margin: 1.5rem 0 0.5rem; }
    p { margin-bottom: 1rem; }
    ul, ol { margin: 0.5rem 0 1rem 1.5rem; }
    li { margin-bottom: 0.3rem; }
    blockquote {
      border-left: 4px solid var(--color-accent);
      padding: 0.75rem 1rem;
      margin: 1rem 0;
      background: #f0fdf4;
      border-radius: 0 8px 8px 0;
    }
    .disclaimer {
      background: #fef3c7;
      border: 1px solid #fbbf24;
      border-radius: 8px;
      padding: 1rem;
      margin: 2rem 0;
      font-size: 0.9rem;
    }
    @media (max-width: 600px) {
      body { font-size: 16px; }
      h1 { font-size: 1.6rem; }
    }
  </style>
</head>
<body>
  <header>
    <nav>
      <a href="/">My Neuralgia</a>
      <a href="/" style="font-weight:400; font-size:0.9rem;">Articles</a>
      <a href="/about" style="font-weight:400; font-size:0.9rem;">About</a>
    </nav>
  </header>
  <main>
    <slot />
  </main>
  <footer>
    <p><strong>Disclaimer:</strong> This content is for educational purposes only and does not replace medical consultation, diagnosis, or treatment. If you experience severe facial pain or concerning symptoms, please contact your doctor.</p>
    <p>&copy; {new Date().getFullYear()} My Neuralgia. All rights reserved.</p>
  </footer>
</body>
</html>
