---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const articles = (await getCollection('articles'))
  .filter(a => a.data.status === 'published')
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
---
<Base
  title="Living with Trigeminal Neuralgia"
  description="A patient-led blog about trigeminal neuralgia, neuropathic pain, and living with chronic facial pain. Knowledge, support, and hope."
  canonical="https://myneuralgia.com/"
>
  <h1>Living with Trigeminal Neuralgia</h1>
  <p>Hi, I'm Natalia. Since 2014, I've been living with chronic pain caused by trigeminal nerve damage. This blog is my space to share knowledge, support, and hope for everyone affected by facial pain.</p>

  <div class="disclaimer">
    <strong>Medical disclaimer:</strong> This content is educational only and does not replace professional medical advice. Always consult your doctor.
  </div>

  <h2>Articles</h2>
  {articles.length === 0 && <p>No articles published yet. Check back soon!</p>}
  {articles.map(article => (
    <article style="margin-bottom: 2rem; padding-bottom: 1.5rem; border-bottom: 1px solid #e5e7eb;">
      <h3><a href={`/${article.data.slug}`}>{article.data.title}</a></h3>
      <time style="color: var(--color-muted); font-size: 0.85rem;">{article.data.date}</time>
    </article>
  ))}
</Base>
