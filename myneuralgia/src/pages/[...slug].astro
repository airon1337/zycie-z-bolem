---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles
    .filter(a => a.data.status === 'published')
    .map(article => ({
      params: { slug: article.data.slug },
      props: { article },
    }));
}

const { article } = Astro.props;
const { Content } = await article.render();

const canonical = `https://myneuralgia.com/${article.data.slug}`;
const hreflangPl = article.data.source_ref
  ? `https://zyciezbolem.pl/${article.data.source_ref.replace('artykuly/', '').replace('.md', '.html')}`
  : undefined;

// Schema.org JSON-LD
const schemaOrg = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: article.data.title,
  description: article.data.meta_description || '',
  datePublished: article.data.date,
  author: { '@type': 'Person', name: 'Natalia' },
  publisher: { '@type': 'Organization', name: 'My Neuralgia' },
  inLanguage: 'en',
  mainEntityOfPage: canonical,
};
---
<Base
  title={article.data.meta_title || article.data.title}
  description={article.data.meta_description}
  canonical={canonical}
  hreflangPl={hreflangPl}
>
  <article>
    <h1>{article.data.title}</h1>
    <time style="color: var(--color-muted); font-size: 0.85rem; display: block; margin-bottom: 1.5rem;">
      {article.data.date}
    </time>

    <Content />

    <div class="disclaimer" style="margin-top: 3rem;">
      <strong>Important:</strong> This article is for educational purposes only. It does not replace medical consultation, diagnosis, or treatment. If you are in pain, please see a neurologist.
    </div>
  </article>

  <script type="application/ld+json" set:html={JSON.stringify(schemaOrg)} />
</Base>
